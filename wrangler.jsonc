{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build:worker"
  }
}
